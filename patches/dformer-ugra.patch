+# =====================================================================
+# PRP (Pseudo-Depth Relational Prior) — n7 method.
+# Env-gated (PRP_ON=1). When OFF the backbone is byte-identical to baseline.
+# The pseudo-depth head reads STAGE-1 RGB-BRANCH features (never the depth
+# encoder), so d-hat is ALIVE under entire_missing (zeroed sensor depth).
+# =====================================================================
+import os as _os
+
+
+def _prp_enabled():
+    return _os.environ.get("PRP_ON", "0") == "1"
+
+
+# --- DEPTH_LAMBDA_TRAIN: global authority scale on the depth relational bias,
+# applied IN THE FORWARD, i.e.
+#   mask = weight[0]*mask_pos + (DEPTH_LAMBDA_TRAIN * weight[1])*mask_d.
+# Depth enters the attention operator ONLY through this term (V is pure RGB and
+# there is no depth encoder), so this is a single dial on the whole depth pathway:
+#   1.0 (default) => byte-identical to the standard recipe;
+#   0.0           => the depth pathway is REMOVED, leaving the spatial-only
+#                    operator. TRAINING at 0.0 yields the in-family RGB-only
+#                    reference A_R^oracle at IDENTICAL parameter count/capacity,
+#                    the control needed to split the observed missing-depth gap
+#                    into (genuine depth information) vs (excess brittleness of
+#                    an operator that was never trained).
+#
+# DELIBERATELY NOT named DEPTH_LAMBDA: the frozen eval harness
+# (scripts/eval_robust_suite.py) already implements eval-only DEPTH_LAMBDA by
+# scaling weight[1] IN PLACE at load time. Sharing one name would apply the
+# factor twice (lambda^2) whenever both paths were active. Separate names keep
+# the frozen eval harness byte-identical (hard rule #1) while giving the
+# TRAINING path its own dial.
+def _depth_lambda() -> float:
+    return float(_os.environ.get("DEPTH_LAMBDA_TRAIN", "1.0"))
+
+
+# --- POSITIONAL-ALPHA CONTROL (P2-CTRL). The matched negative control for C2.
+#
+# WHY. C2 scales the normalized depth input by alpha ~ U(alpha_min,1), which scales the DEPTH
+# bias mask_d by exactly alpha. Two rival accounts of its gain: (i) it is depth-SPECIFIC repair
+# of a corrupted operator, or (ii) it is a generic noise-injection regularizer on attention
+# logits. They are separated by applying the SAME augmentation family to a DEPTH-IRRELEVANT term
+# of the same module and functional form: the POSITIONAL bias weight[0]*mask_pos. Eval never
+# removes the positional term, so this arm is not a disqualified (n2-class) recipe.
+#
+# MATCHING MATTERS: C2 draws ONE alpha per SAMPLE and that alpha is shared across all 29
+# GeoPriorGen modules (because it scales the shared depth input). An independent draw inside each
+# module would be a DIFFERENT, weaker perturbation. So alpha is set ONCE per forward by the
+# trainer and read by every module here.
+#
+# Shapes: the positional mask is BATCH-SHARED ((n_heads,H,H) or (n_heads,HW,HW)) while the depth
+# mask is per-sample, so alpha is broadcast as (B,1,1,1,1) in the split branch and (B,1,1,1) in
+# the non-split branch.
+_POS_ALPHA = None
+
+
+def set_pos_alpha(a) -> None:
+    """Set the per-forward positional-attenuation factor (a tensor of shape (B,) or None)."""
+    global _POS_ALPHA
+    _POS_ALPHA = a
+
+
+def get_pos_alpha():
+    return _POS_ALPHA
+
+
+def _pos_weight(w0, ndim: int):
+    """w0 scaled by the current positional alpha, broadcast for a `ndim`-dim mask term."""
+    a = _POS_ALPHA
+    if a is None:
+        return w0
+    return w0 * a.reshape(-1, *([1] * (ndim - 1))).to(w0.device, w0.dtype)
+
+
+# --- PRP escape-velocity gate (n7 re-screen). A module-global ramp multiplier
+# g in [0,1] applied to w_p in the forward so the trainer can (a) hold mask_p
+# OFF during an aux-only warmup (g=0, d-hat trains, ckpt untouched) then
+# (b) ramp mask_p ON (g: 0->1) once d-hat is trained-enough. w_p itself stays a
+# LEARNABLE, warm-INIT (nonzero) parameter in a no-WD higher-LR group, so once
+# g>0 SGD is free to grow/shrink it -- the gate only controls WHEN it engages,
+# not its learned magnitude. Default 1.0 so eval/probe (no trainer) is unaffected.
+_PRP_GATE = {"g": 1.0}
+
+
+def set_prp_gate(g: float) -> None:
+    _PRP_GATE["g"] = float(g)
+
+
+def get_prp_gate() -> float:
+    return float(_PRP_GATE["g"])
+
+
+class PseudoDepthHead(nn.Module):
+    """RGB-branch pseudo-depth head. Input: stage-1 RGB features (b, h, w, c_in).
+    Output: per-image-scale-normalized inverse-depth map d-hat (b, 1, h, w).
+
+    2x [Conv3x3-BN-ReLU dim64] then a 1x1 to a single channel; a learnable
+    positive scale scalar (init 1.0) rescales the raw map. ~0.2M params.
+    Reads RGB features only => depth-invariant (P2)."""
+
+    def __init__(self, c_in, hidden=64):
+        super().__init__()
+        self.body = nn.Sequential(
+            nn.Conv2d(c_in, hidden, 3, 1, 1),
+            nn.BatchNorm2d(hidden),
+            nn.ReLU(inplace=True),
+            nn.Conv2d(hidden, hidden, 3, 1, 1),
+            nn.BatchNorm2d(hidden),
+            nn.ReLU(inplace=True),
+        )
+        self.head = nn.Conv2d(hidden, 1, 1, 1, 0)
+        self.scale = nn.Parameter(torch.ones(1))
+
+    def forward(self, x_bhwc: torch.Tensor) -> torch.Tensor:
+        # x_bhwc: (b, h, w, c) RGB-branch stage-1 features
+        x = x_bhwc.permute(0, 3, 1, 2).contiguous()  # (b, c, h, w)
+        x = self.body(x)
+        d = self.head(x)  # (b, 1, h, w) raw inverse-depth
+        d = d * self.scale
+        return d
+
